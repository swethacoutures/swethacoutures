# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Secrets — never commit. Use .env.example as the template.
.env
.env.*
!.env.example

# Firebase service-account keys. These bypass every Firestore security rule, so a
# committed one hands the whole database to anyone who can read the repo.
*firebase-adminsdk*.json
*service-account*.json
serviceAccountKey.json

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.clockwatch/
