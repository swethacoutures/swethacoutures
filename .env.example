# =============================================================================
# Swetha's Couture — environment template
# =============================================================================
# Copy this file to ".env" and fill in the values, then restart the dev server.
# For production: paste the same variables into
#   Vercel -> Project -> Settings -> Environment Variables, then redeploy.
#
# Anything prefixed VITE_ is compiled into the browser bundle and is therefore
# PUBLIC. Anything without the prefix is server-side only.
# =============================================================================

# =============================================================================
# Firebase (REQUIRED — the app refuses to start without these)
# =============================================================================
# Firebase Console -> Project settings -> Your apps -> SDK setup and config.
#
# A Firebase web config is public by design: it identifies your project, it does
# not authorise anything. Your data is protected by Firestore Security Rules, so
# make sure those are locked down to signed-in users with the right role.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# =============================================================================
# Cloudinary (REQUIRED for design images & payment screenshots)
# =============================================================================
# 1. Free account: https://cloudinary.com/users/register_free
# 2. Copy the "Cloud name" from the dashboard.
# 3. Settings -> Upload -> Add upload preset
#      Signing Mode: Unsigned   <-- important
#      Name it, then put that name below.
# No API secret is used in the browser, so nothing sensitive is exposed.
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=your-unsigned-preset

# =============================================================================
# Fingerprint device (ZKTeco K40 Pro) — see docs/BIOMETRIC_DEVICE.md
# =============================================================================
# The device pushes punches to /iclock/cdata. In production that is a Vercel
# serverless function; during `npm run dev` the same handler is served on your
# LAN so the device can be tested before anything is deployed.

# --- Firebase Admin (REQUIRED for the device endpoint) ----------------------
# ⚠️ NO "VITE_" PREFIX. These are server-side only. This key BYPASSES Firestore
# security rules — adding VITE_ would publish full database access to every
# visitor's browser.
#
# Firebase Console -> Project settings -> Service accounts ->
# "Generate new private key". Copy three values out of the downloaded JSON.
#
# Put the same three in Vercel -> Settings -> Environment Variables for production.
FIREBASE_PROJECT_ID=swetha-couture
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@swetha-couture.iam.gserviceaccount.com

# The whole "private_key" value from the JSON, on ONE line, keeping the literal
# \n sequences exactly as they appear. Wrap in double quotes here in .env.
# (In the Vercel dashboard, paste it WITHOUT surrounding quotes.)
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"

# --- Device behaviour (all optional) ----------------------------------------
# The timezone the DEVICE's clock is set to — not the server's. India = +05:30.
# The raw string is always stored too, so a wrong value here is recoverable.
DEVICE_TZ_OFFSET=+05:30

# What the device internally THINKS its timezone is. The terminal reads the HTTP
# Date header and adds this offset to compute the time it displays, so when this
# differs from DEVICE_TZ_OFFSET the server shifts the Date header to compensate.
#
# LEAVE THIS BLANK. Blank means no shift — send the honest time — and the server
# measures each terminal's real error from its own punches and corrects that
# device on its own. Setting it on a guess ("ZKTeco ships from China on +08:00")
# is what put the shop clock 2h30m SLOW on a terminal that was already correct.
# Only set it to skip the two-punch learning period on a device you have measured.
DEVICE_INTERNAL_TZ=

# Comma-separated serial-number allowlist. Leave empty until a real punch works,
# then fill it in: this endpoint is public and anyone who finds the URL could
# otherwise post attendance. An unlisted serial is silently ignored.
DEVICE_SERIALS=

# Trust any device that connects, skipping the approve-in-the-app step.
# Leave false — new devices are quarantined and their punches held until approved.
AUTO_APPROVE_DEVICES=false

# data (default) = log every upload. all = also log the ~30s command polls
# (~3000 extra documents a day; only while debugging). off = no raw logs.
RAW_LOG_MODE=data
RAW_LOG_RETENTION_DAYS=14

# --- Health signal (browser-visible, so VITE_ prefix is correct) -------------
# Minutes the terminal may stay silent before the Attendance page flags it as
# faulty. It checks in about every 30 seconds even when nobody punches, so 15
# minutes is many missed check-ins — long enough to ride out a network blip,
# short enough to catch a dead device the same morning instead of at payroll.
VITE_DEVICE_STALE_MINUTES=15
